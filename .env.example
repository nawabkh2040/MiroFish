# ===== LLM configuration (any OpenAI SDK-compatible API) =====
# Using Google Gemini via its official OpenAI-compatible endpoint.
# Get an API key at: https://aistudio.google.com/apikey
# "gemini-flash-lite-latest" is Google's alias for its current cheapest/fastest
# model, and it automatically rolls forward to newer Gemini releases (including
# the Gemini 3 series) as Google updates it — no need to edit this when a new
# model ships. For production stability you can pin an exact version instead,
# e.g. gemini-2.5-flash-lite or a specific gemini-3.x-flash-lite release.
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL_NAME=gemini-flash-lite-latest

# ===== ZEP记忆图谱配置 =====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here