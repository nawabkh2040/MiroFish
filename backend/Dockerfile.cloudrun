# Production image for Google Cloud Run.
#
# Differs from the root Dockerfile (which runs the Flask/Vite dev servers for
# local docker-compose use) in three ways: a production WSGI server
# (gunicorn) instead of `flask run`, a single port via Cloud Run's $PORT, and
# CPU-only torch wheels (see [tool.uv.sources] in pyproject.toml) so no
# nvidia/CUDA stack is pulled in for a GPU this service never uses.

FROM python:3.11-slim

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:0.9.26 /uv /uvx /bin/

# Install dependencies first so this layer is cached across source-only changes.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY . .
RUN uv sync --frozen --no-dev

ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 8080

# gunicorn's --factory flag calls create_app() with no arguments and serves
# the resulting Flask app (app/__init__.py:create_app).
CMD exec gunicorn \
    --bind 0.0.0.0:${PORT:-8080} \
    --workers 2 \
    --threads 4 \
    --timeout 0 \
    --factory "app:create_app"
